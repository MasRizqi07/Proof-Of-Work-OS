{
  "name": "proof-of-work-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace client run dev\"",
    "start": "npm --workspace server run start",
    "build": "npm --workspace client run build",
    "lint": "echo \"No lint configured yet\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
