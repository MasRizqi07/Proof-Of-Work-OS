{
  "name": "proof-of-work-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install-all": "npm install",
    "dev": "concurrently \"npm --workspace server run dev\" \"npm --workspace client run dev\"",
    "start": "npm --workspace server run start",
    "build": "npm --workspace client run build",
    "test": "npm --workspace server test && npm --workspace client test",
    "lint": "eslint .",
    "format": "prettier --write \"server/**/*.js\" \"client/src/**/*.{js,jsx,css}\" \"prisma/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"server/**/*.js\" \"client/src/**/*.{js,jsx,css}\" \"prisma/**/*.js\" \"*.{js,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3"
  }
}
